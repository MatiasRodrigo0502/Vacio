[node name="Reglas" type="Label" parent="PanelControles/Centro/Caja"]
modulate = Color(0.85098, 0.803922, 0.760784, 1)
layout_mode = 2
theme_override_constants/line_spacing = 8
theme_override_font_sizes/font_size = 17
text = "Baja hasta el círculo del fondo para pasar al piso siguiente.
Disparas con las flechas o apuntando con el ratón: matan enemigos.
Mantén el clic derecho para cargar un ataque: cuando el aro se cierre, suéltalo.
El cargado atraviesa enemigos y mata de un golpe, pero las rocas lo paran igual.
Las rocas son sólidas: no se pueden cruzar ni romper, pero te sirven de parapeto.
Lo que te quita vida son los enemigos al tocarte.
En cada piso hay un objeto que te mejora para el resto de la partida.
Doce pisos, y cada uno más estrecho que el anterior."
horizontal_alignment = 1

