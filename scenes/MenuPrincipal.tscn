[node name="Reglas" type="Label" parent="PanelControles/Centro/Caja"]
modulate = Color(0.85098, 0.803922, 0.760784, 1)
layout_mode = 2
theme_override_constants/line_spacing = 3
theme_override_font_sizes/font_size = 17
text = "Cada piso es un mapa de salas: busca la del agujero para bajar al siguiente.
Al entrar en una sala con enemigos se cierran las puertas hasta que acabes con ellos.
Disparas con las flechas o apuntando con el ratón: matan enemigos.
Mantén el clic derecho o el espacio para cargar un ataque: cuando el aro se cierre, suéltalo.
Con el clic derecho sale hacia el ratón; con el espacio, hacia donde apuntan las flechas.
El cargado atraviesa enemigos y pega más fuerte; el del mago oscuro abre un agujero negro.
El mago blanco, en vez de cargar, saca con ese botón un escudo. El ataque especial es uno por piso.
Las rocas son sólidas: no se pueden cruzar ni romper, pero te sirven de parapeto.
Te quitan vida los enemigos, sus disparos, los pinchos, la lava y caer al vacío.
Hay un objeto por piso y a veces un enemigo suelta otro. Al limpiar una sala puede caer un corazón.
Doce pisos: cada uno con más salas, más pequeñas, y cada vez se ve menos."
horizontal_alignment = 1

