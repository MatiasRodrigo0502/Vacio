# Los archivos de Godot son texto: forzamos finales de linea LF para que
# las tres personas del equipo no generen diffs falsos por CRLF/LF.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf

# Binarios
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary
